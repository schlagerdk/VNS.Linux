{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "uSync": {
    "Settings": {
	  "IsRootSite" : false,
	  "FailOnMissingParent": true,
      "UiEnabledGroups": "Settings"
    },
    "Sets": {
      "Default": {
		"HandlerDefaults" :{
		  "GuidNames": true,
		  "FailOnMissingParent": true,
          "Settings": {
          }
        },
        "DisabledHandlers": [
          "ContentHandler",
          "MediaHandler"
        ]
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "WebRouting": {
        "UmbracoApplicationUrl": "https://FolderName"
      },
      "Global": {
        "Id": "UUID",
        "UseHttps": true,
        "Smtp": {
          "SecureSocketOptions": "None",
          "Name": "VNS ApS",
          "From": "no-reply@vns.dk",
          "Host": "mailserver.vns.dk",
          "Port": 25
        }
      },
      "Content": {
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        },
        "Notifications": {
          "Email": "no-reply@vns.dk"
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      }
    }
  }
}